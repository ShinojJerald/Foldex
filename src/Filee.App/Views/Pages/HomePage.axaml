<!-- Home: hero, drop zone with Browse, tool tiles, recent files, quick tools, the live task queue and conversion history. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:app="using:Filee.App.ViewModels"
             x:Class="Filee.App.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Grad.Red" Color="#E11D48" />
    <SolidColorBrush x:Key="Grad.Blue" Color="#2563EB" />
    <SolidColorBrush x:Key="Grad.Green" Color="#059669" />
    <SolidColorBrush x:Key="Grad.Violet" Color="#7C3AED" />
    <SolidColorBrush x:Key="Grad.Indigo" Color="#4338CA" />
    <SolidColorBrush x:Key="Grad.Amber" Color="#D97706" />
    <SolidColorBrush x:Key="Grad.Cyan" Color="#0891B2" />
    <SolidColorBrush x:Key="Grad.Pink" Color="#C026D3" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border#DropZone">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#DropZone.over">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="PathIcon.chevron"><Setter Property="RenderTransform" Value="rotate(0deg)" /></Style>
    <Style Selector="PathIcon.chevron.open"><Setter Property="RenderTransform" Value="rotate(90deg)" /></Style>
    <!-- Big tool tiles: icon above, title and caption -->
    <Style Selector="Button.tool">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.quick">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="Button.quick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.filter">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="18">
    <!-- macOS without Accessibility permission -->
    <Border IsVisible="{Binding NeedsAccessibility}" Classes="card" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Classes="accent"
                Content="{DynamicResource triggers.open_accessibility}" Command="{Binding OpenAccessibilityCommand}" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource home.accessibility_needed}" />
      </DockPanel>
    </Border>
    <!-- Running as administrator: Explorer can't drop files here -->
    <Border IsVisible="{Binding IsElevated}" Classes="card" BorderBrush="{DynamicResource DangerBrush}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Classes="accent"
                Content="{DynamicResource home.elevated_restart}" Command="{Binding RestartWithoutAdministratorRightsCommand}" />
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock TextWrapping="Wrap" Text="{DynamicResource home.elevated}" />
          <TextBlock Classes="caption danger" TextWrapping="Wrap" IsVisible="{Binding ElevationRestartFailed}"
                     Text="{DynamicResource home.elevated_restart_failed}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ───────── Hero ───────── -->
    <Border CornerRadius="22" ClipToBounds="True" Height="250" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
            BoxShadow="{DynamicResource CardShadow}" Background="#090C26">
      <Panel>
        <Image Source="avares://Filee/Assets/Images/hero.jpg" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <StackPanel Margin="34,30,0,0" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="560">
          <TextBlock Classes="display" Foreground="White" Text="{DynamicResource home.hero_line1}" />
          <TextBlock Classes="display" Foreground="{DynamicResource BrandGradientBrush}" Text="{DynamicResource home.hero_line2}" />
          <TextBlock Foreground="#C9D0F0" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap" Text="{DynamicResource home.hero_sub}" />
        </StackPanel>
      </Panel>
    </Border>

    <Grid x:Name="Columns" ColumnDefinitions="*,18,340">
      <!-- ───────── Left column ───────── -->
      <StackPanel Spacing="16">
        <!-- Drop zone -->
        <Border x:Name="DropZone" DragDrop.AllowDrop="True" MinHeight="200" Padding="24"
                Background="{DynamicResource AccentFaintBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1.5" CornerRadius="{DynamicResource SoftRadiusLarge}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <PathIcon Width="34" Height="34" Data="{StaticResource Icon.Upload}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Classes="h2" FontSize="18" HorizontalAlignment="Center" Text="{DynamicResource home.drop_title}" />
            <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                       Text="{Binding DropHint}" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,4">
              <Button x:Name="BrowseFiles" Classes="accent" Padding="22,10" Click="OnBrowseFiles" ToolTip.Tip="{DynamicResource home.browse_hint}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Folder}" />
                  <TextBlock Text="{DynamicResource home.browse_files}" />
                </StackPanel>
              </Button>
              <Button x:Name="BrowseFolder" Padding="22,10" Click="OnBrowseFolder" ToolTip.Tip="{DynamicResource home.browse_hint}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Folder}" />
                  <TextBlock Text="{DynamicResource home.browse_folder}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{DynamicResource home.supports}" />
          </StackPanel>
        </Border>

        <!-- Tool tiles -->
        <UniformGrid x:Name="Tools" Columns="6" Margin="-4,0">
          <Button Classes="tool" Click="OnEditPdf" AutomationProperties.Name="{DynamicResource nav.pdf_editor}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Border Classes="tileicon" Background="{StaticResource Grad.Red}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Icon.File}" /></Border>
              <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Text="{DynamicResource nav.pdf_editor}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{DynamicResource home.tile.pdf}" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnBrowseFiles" AutomationProperties.Name="{DynamicResource home.tile.convert_title}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Border Classes="tileicon" Background="{StaticResource Grad.Blue}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Icon.Convert}" /></Border>
              <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Text="{DynamicResource home.tile.convert_title}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{DynamicResource home.tile.convert}" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnPdfTools" AutomationProperties.Name="{DynamicResource tools.compress}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Border Classes="tileicon" Background="{StaticResource Grad.Green}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Icon.Compress}" /></Border>
              <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Text="{DynamicResource home.tile.compress_title}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{DynamicResource home.tile.compress}" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnPdfTools" AutomationProperties.Name="{DynamicResource home.tile.merge_title}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Border Classes="tileicon" Background="{StaticResource Grad.Violet}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Icon.Merge}" /></Border>
              <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Text="{DynamicResource home.tile.merge_title}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{DynamicResource home.tile.merge}" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnEditPdf" AutomationProperties.Name="{DynamicResource home.tile.sign_title}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Border Classes="tileicon" Background="{StaticResource Grad.Indigo}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Icon.Pencil}" /></Border>
              <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Text="{DynamicResource home.tile.sign_title}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{DynamicResource home.tile.sign}" />
            </StackPanel>
          </Button>
          <Button Classes="tool" Click="OnAutomation" AutomationProperties.Name="{DynamicResource home.tile.automation_title}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <Border Classes="tileicon" Background="{StaticResource Grad.Pink}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Icon.Robot}" /></Border>
              <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center" Text="{DynamicResource home.tile.automation_title}" />
              <TextBlock Classes="caption" HorizontalAlignment="Center" Text="{DynamicResource home.tile.automation}" />
            </StackPanel>
          </Button>
        </UniformGrid>

        <!-- Recent files -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{DynamicResource home.recent_files}" />
            <ItemsControl ItemsSource="{Binding Filters}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentFilter">
                  <ToggleButton Classes="filter" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).FilterCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" Text="{DynamicResource home.recent_files_empty}" IsVisible="{Binding !HasRecentFiles}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding RecentFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentFileItem">
                  <Border Classes="row" CornerRadius="10" Padding="8,6" Background="Transparent">
                    <Grid ColumnDefinitions="Auto,*,150,80,Auto">
                      <Border Width="34" Height="34" CornerRadius="9" Background="{Binding BadgeColor}" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Button Grid.Column="1" Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Click="OnOpenRecent" Tag="{Binding Path}" ToolTip.Tip="{Binding Path}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                      <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="{Binding When}" />
                      <TextBlock Grid.Column="3" Classes="caption" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Size}" />
                      <Button Grid.Column="4" Classes="icon" Margin="8,0,0,0" ToolTip.Tip="{DynamicResource home.open_folder}"
                              AutomationProperties.Name="{DynamicResource home.open_folder}"
                              Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).RevealFileCommand}" CommandParameter="{Binding Path}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Folder}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Conversion history (retry failed files, open output folders) -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost" Content="{DynamicResource home.clear_history}" Command="{Binding ClearHistoryCommand}" />
              <TextBlock Classes="h2" VerticalAlignment="Center" Text="{DynamicResource home.recent}" />
            </DockPanel>
            <TextBlock Classes="muted" Text="{DynamicResource home.recent_empty}" IsVisible="{Binding IsEmpty}" />
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                  <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="12,9">
                    <StackPanel Spacing="8">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasOutputs}" Padding="10,5">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Folder}" />
                            <TextBlock Text="{DynamicResource home.open_folder}" />
                          </StackPanel>
                        </Button>
                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="999" Margin="0,0,12,0" Background="{DynamicResource AccentSoftBrush}">
                          <Panel>
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding !HasErrors}" />
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Alert}" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasErrors}" />
                          </Panel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                            <TextBlock Classes="caption" Text="·" />
                            <TextBlock Classes="caption" Text="{Binding Time}" />
                          </StackPanel>
                        </StackPanel>
                      </DockPanel>
                      <DockPanel IsVisible="{Binding HasFailures}" Margin="42,0,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Padding="10,5">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                            <TextBlock Text="{DynamicResource common.retry}" />
                          </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding ToggleFailuresCommand}" Padding="6,4" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="chevron" Classes.open="{Binding ShowFailures}" Width="12" Height="12" Data="{StaticResource Icon.ChevronRight}" />
                            <TextBlock Classes="caption danger" Text="{Binding FailureSummary}" />
                          </StackPanel>
                        </Button>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding Failures}" IsVisible="{Binding ShowFailures}" Margin="48,0,0,2">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="app:FailureItem">
                            <StackPanel>
                              <SelectableTextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                              <SelectableTextBlock Classes="caption danger" Text="{Binding Reason}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ───────── Right column ───────── -->
      <StackPanel x:Name="Side" Grid.Column="2" Spacing="16">
        <!-- Task queue: conversions running now -->
        <Border Classes="card" Padding="16,14">
          <StackPanel Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="ghost" Padding="6,2" Command="{Binding ClearFinishedJobsCommand}">
                <TextBlock Classes="link" FontSize="12.5" Text="{DynamicResource home.queue_clear}" />
              </Button>
              <TextBlock Classes="h2" VerticalAlignment="Center" Text="{DynamicResource home.queue}" />
            </DockPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource home.queue_empty}" IsVisible="{Binding !Jobs.Count}" />
            <ItemsControl ItemsSource="{Binding Jobs}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:JobViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,10,0" VerticalAlignment="Top">
                      <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Convert}" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                      <ProgressBar Classes="soft" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                    </StackPanel>
                    <Panel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top">
                      <Button Classes="icon" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}"
                              ToolTip.Tip="{DynamicResource toast.cancel}" AutomationProperties.Name="{DynamicResource toast.cancel}">
                        <PathIcon Width="11" Height="11" Data="{StaticResource Icon.Close}" />
                      </Button>
                      <Button Classes="icon" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasOutputs}"
                              ToolTip.Tip="{DynamicResource home.open_folder}" AutomationProperties.Name="{DynamicResource home.open_folder}">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Folder}" />
                      </Button>
                    </Panel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- How the gesture works -->
        <Border Classes="card" Padding="16,14">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="tileicon" Width="32" Height="32" CornerRadius="9" Background="{StaticResource Grad.Indigo}"><PathIcon Width="16" Height="16" Data="{StaticResource Icon.Panel}" /></Border>
              <TextBlock Classes="h2" VerticalAlignment="Center" Text="{DynamicResource home.panel_title}" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource home.panel_text}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
