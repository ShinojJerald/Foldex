<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Filee.App"
             x:Class="Filee.App.App"
             Name="Filee"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <!-- Maps FooPageViewModel â†’ FooPage view (see ViewLocator.cs). -->
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Filee/Styles/Icons.axaml" />
        <ResourceInclude Source="avares://Filee/Styles/Brands.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Filee/Styles/Soft.axaml" />
    <StyleInclude Source="avares://Filee/Styles/TagEditor.axaml" />
    <!-- The main window draws its own top bar into the title bar; the decorations' title text sat over the logo.
         (Window decorations are styled from here, not from the window.) The taskbar keeps the window title. -->
    <Style Selector="WindowDrawnDecorations /template/ TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>
</Application>
