<!--
  Filee.App: the Avalonia desktop application (tray, donut toolbar, settings window).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Filee</AssemblyName>
    <!-- Shown by Windows (Task Manager, file properties); the published exe is renamed Foldex.exe. -->
    <AssemblyTitle>Foldex</AssemblyTitle>
    <RootNamespace>Filee.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\filee.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
    <ProjectReference Include="..\Filee.Engines\Filee.Engines.csproj" />
    <ProjectReference Include="..\Filee.Platform.Windows\Filee.Platform.Windows.csproj" />
    <ProjectReference Include="..\Filee.Platform.Linux\Filee.Platform.Linux.csproj" />
    <ProjectReference Include="..\Filee.Platform.MacOS\Filee.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="SharpHook" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The licenses ship next to Foldex.exe (the sidebar's "Licenses" link shows them). -->
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- SIL OFL texts of the bundled signature fonts travel with them. -->
    <Content Include="Assets\Fonts\Signatures\OFL-*.txt" Link="licenses\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Filee.App.Tests" />
  </ItemGroup>

  <!-- Native debug symbols from NuGet packages (SkiaSharp, HarfBuzz: ~100 MB) are useless to users. -->
  <Target Name="FileeRemoveNativeSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_FileeNativePdb Include="$(PublishDir)lib*.pdb" />
    </ItemGroup>
    <Delete Files="@(_FileeNativePdb)" />
  </Target>

  <!-- Repository URL for the updater / About page, taken from Directory.Build.props. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryUrl</_Parameter1>
      <_Parameter2>$(FileeRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
    <!-- Published builds (installer, portable zip) set -p:FileeRelease=true: only they register Explorer and startup
         entries (UpdateService.IsReleaseBuild), so running from source leaves the user's system alone. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(FileeRelease)' == 'true'">
      <_Parameter1>FileeRelease</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
